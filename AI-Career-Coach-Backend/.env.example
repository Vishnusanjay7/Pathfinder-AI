# Backend Production Environment Variables Example
# Set these variables in Render / Supabase / Production Web Service environment settings

# Database Configuration (PostgreSQL on Supabase Free or SQLite fallback)
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Security & Authentication
SECRET_KEY=generate-a-secure-random-32-character-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_PROVIDER=development

# Frontend CORS URL
FRONTEND_URL=https://your-frontend-domain.onrender.com

# AI Provider API Keys (Keep secret, do not commit!)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# Speech & Voice (Deepgram Aura TTS)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
