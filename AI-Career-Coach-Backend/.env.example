# ==========================================
# AI Career Coach — Backend Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ==========================================
# Database (PostgreSQL on Supabase or local)
# ==========================================
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ==========================================
# Security & Authentication
# ==========================================
SECRET_KEY=generate-a-secure-random-32-character-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OTP Provider: development | smtp | twilio
OTP_PROVIDER=development

# ==========================================
# CORS
# ==========================================
FRONTEND_URL=http://localhost:3000

# ==========================================
# AI Provider Configuration
# ==========================================
AI_PROVIDER=openrouter
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==========================================
# Code Execution Engine
# ==========================================
EXECUTION_ENGINE_URL=http://localhost:9000
JUDGE0_URL=https://ce.judge0.com

# ==========================================
# SMTP (for OTP email delivery)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=

# ==========================================
# Twilio (for OTP SMS delivery)
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_PHONE_NUMBER=

# ==========================================
# LiveKit (Real-time WebRTC)
# ==========================================
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ==========================================
# Deepgram (Speech-to-Text & Text-to-Speech)
# ==========================================
DEEPGRAM_API_KEY=

# ==========================================
# Tavus (Photorealistic AI Video Avatar)
# ==========================================
TAVUS_API_KEY=

# ==========================================
# OCR (Resume Parsing)
# ==========================================
# POPPLER_PATH=C:\poppler\Library\bin
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# ==========================================
# Job Search Providers
# ==========================================
# JOB_SEARCH_PROVIDER=jsearch
# RAPIDAPI_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in
